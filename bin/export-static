#!/usr/bin/env python3
import argparse
import json
import re
import shutil
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
WEB_DIR = REPO / "web"
OUT_DIR = REPO / "docs" / "app"
STATIC_DATA_DIR = "./data"
TOP_LEVEL_ENDPOINTS = ("graph", "hypotheses", "audit", "score")


def fetch(base_url, path):
    with urllib.request.urlopen(base_url + path, timeout=60) as response:
        return response.read()


def fetch_json(base_url, path):
    return json.loads(fetch(base_url, path))


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, separators=(",", ":")))


def case_file_name(case_id):
    return case_id.replace(":", "_") + ".json"


def static_index_html():
    html = (WEB_DIR / "index.html").read_text()
    html = html.replace('href="styles.css"', 'href="./styles.css"')
    bootstrap = f'<script>window.CASELINK_STATIC = "{STATIC_DATA_DIR}";</script>\n'
    return html.replace('<script src="app.js"></script>', bootstrap + '<script src="./app.js"></script>')


def series_media_urls(node):
    series = re.sub(r"^[a-z_]+:", "", node["id"])
    names = {Path(item["path"]).name for item in node["props"].get("media") or []}
    return [f"/api/media/{series}/_series/{name}" for name in sorted(names)]


def collect_media_urls(graph, details):
    urls = set()
    for detail in details.values():
        urls.update(item["url"] for item in detail.get("media") or [] if item.get("url"))
    for node in graph["nodes"]:
        if node["type"] == "series":
            urls.update(series_media_urls(node))
    return sorted(urls)


def download_media(base_url, urls):
    missing = []
    for url in urls:
        target = OUT_DIR / "media" / urllib.parse.unquote(url.removeprefix("/api/"))
        try:
            body = fetch(base_url, url)
        except Exception:
            missing.append(url)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(body)
    return missing


def export_leads(base_url, graph):
    for node in graph["nodes"]:
        if node["type"] != "series":
            continue
        try:
            sheet = fetch_json(base_url, f"/api/series/{urllib.parse.quote(node['id'], safe='')}/leads")
        except urllib.error.HTTPError as error:
            if error.code == 404:
                continue
            raise
        write_json(OUT_DIR / "data" / "series" / case_file_name(node["id"]), sheet)


def export(base_url):
    if OUT_DIR.exists():
        shutil.rmtree(OUT_DIR)
    OUT_DIR.mkdir(parents=True)
    shutil.copy(WEB_DIR / "app.js", OUT_DIR / "app.js")
    shutil.copy(WEB_DIR / "styles.css", OUT_DIR / "styles.css")
    (OUT_DIR / "index.html").write_text(static_index_html())

    payloads = {name: fetch_json(base_url, f"/api/{name}") for name in TOP_LEVEL_ENDPOINTS}
    for name, payload in payloads.items():
        write_json(OUT_DIR / "data" / f"{name}.json", payload)

    graph = payloads["graph"]
    case_ids = [node["id"] for node in graph["nodes"] if node["type"] == "case"]
    details = {}
    for case_id in case_ids:
        details[case_id] = fetch_json(base_url, f"/api/cases/{urllib.parse.quote(case_id, safe='')}")
        write_json(OUT_DIR / "data" / "cases" / case_file_name(case_id), details[case_id])

    export_leads(base_url, graph)

    urls = collect_media_urls(graph, details)
    missing = download_media(base_url, urls)
    print(f"nodes={len(graph['nodes'])} edges={len(graph['edges'])} cases={len(case_ids)} media={len(urls) - len(missing)}/{len(urls)}")
    for url in missing:
        print(f"missing media: {url}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description="Export a read-only static copy of the app into docs/app")
    parser.add_argument("--base-url", default="http://127.0.0.1:8000")
    export(parser.parse_args().base_url.rstrip("/"))


if __name__ == "__main__":
    main()
